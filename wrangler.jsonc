{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "startupzconnect",
  "compatibility_date": "2024-04-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://startupzconnect.pages.dev",
    "NODE_VERSION": "20"
  }
}
