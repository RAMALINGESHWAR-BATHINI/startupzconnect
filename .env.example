# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored — never commit real secrets.
# Every value below is a placeholder. Generate secrets with: openssl rand -base64 64

# ── Auth (REQUIRED) ──
# HS256 JWT signing keys for access (15 min) and refresh (7 day) tokens.
# Use two DIFFERENT random values. Rotating them invalidates all sessions.
ACCESS_TOKEN_SECRET=your-very-long-random-access-token-secret-here
REFRESH_TOKEN_SECRET=your-very-long-random-refresh-token-secret-here

# Public base URL of the deployment (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Email — Resend (REQUIRED before real users sign up) ──
# Without these, verification / password-reset emails only log to the
# server console instead of being sent. Get a key at resend.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=StartupzConnect <noreply@yourdomain.com>

# ── File storage — Cloudflare R2 (REQUIRED before real inspections) ──
# Without these, uploads fall back to writing under /public/uploads, which
# only works with `npm run dev` — NOT on Cloudflare Workers in production.
# Public bucket serves visitor-facing assets; private bucket holds
# inspection/field-agent uploads and must not be publicly readable.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=your-public-bucket-name
R2_PRIVATE_BUCKET_NAME=your-private-bucket-name
R2_PUBLIC_URL=https://assets.yourdomain.com

# ── Cloudflare Turnstile (OPTIONAL bot protection) ──
# When TURNSTILE_SECRET_KEY is set, login / register / forgot-password /
# resend-verification fail closed unless the request carries a valid
# Turnstile token. Leave empty to disable the check (local dev only).
TURNSTILE_SECRET_KEY=

# ── Cloudflare D1 (set automatically in Cloudflare Workers env — do not set locally) ──
# DB=<bound D1 database>

# ── Admin/agent bootstrap (used once, by `npm run db:seed`) ──
# Creates the first ADMIN account and registers it as a field agent.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password-min-8-chars
ADMIN_NAME=Your Name

# ── Error alerting (OPTIONAL) ──
# A Slack "Incoming Webhook" URL. Without this, errors still log to the
# console / Cloudflare logs — this just also pings you in real time.
ERROR_WEBHOOK_URL=

DATABASE_URL=file:./dev.db
