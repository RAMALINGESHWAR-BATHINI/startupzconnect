# Copy this to .env.local and fill in your values
# Never commit real secrets to source control.

# ── Auth (required) ──
# Generate with: openssl rand -base64 64
ACCESS_TOKEN_SECRET=your-very-long-random-access-token-secret-here
REFRESH_TOKEN_SECRET=your-very-long-random-refresh-token-secret-here

# Your deployment URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Email — Resend (required before real users sign up) ──
# Without these, all emails (verification, password reset, notifications-by-email)
# just log to the server console instead of sending. Get a key at resend.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=StartupzConnect <noreply@yourdomain.com>

# ── File storage — Cloudflare R2 (required before real inspections) ──
# Two separate buckets: public for non-sensitive assets, private for
# verification documents/resumes/inspections (accessed via signed URLs only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=startupzconnect-public
R2_PRIVATE_BUCKET_NAME=startupzconnect-private
R2_PUBLIC_URL=https://assets.startupzconnect.com

# ── Cloudflare D1 (set automatically in Cloudflare Workers env — do not set locally) ──
# DB=<bound D1 database>

# ── Cloudflare Turnstile (registration + password reset) ──
# Get site/secret keys from Cloudflare dashboard. Never expose the secret key.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Admin/agent bootstrap (used once, by `npm run db:seed`) ──
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password-min-8-chars
ADMIN_NAME=Your Name

# ── Error alerting (optional) ──
# A Slack "Incoming Webhook" URL.
ERROR_WEBHOOK_URL=
