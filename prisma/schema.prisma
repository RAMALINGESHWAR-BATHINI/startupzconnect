generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id              Int                      @id @default(autoincrement())
  name            String
  slug            String?                  @unique
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  memberships     OrganizationMembership[]
  rfqsAsBuyer     Rfq[]                    @relation("RfqBuyer")
  rfqResponses    RfqResponse[]            @relation("RfqVendor")
  savedBy         SavedOrganization[]      @relation("SavedOrg")
  startups        Startup[]
  vendorOfferings VendorOffering[]

  @@index([name])
}

model OrganizationMembership {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model User {
  id                         Int                      @id @default(autoincrement())
  name                       String
  email                      String                   @unique
  password                   String
  role                       String                   @default("USER")
  bio                        String?
  skills                     String?
  location                   String?
  portfolio                  String?
  avatarUrl                  String?
  status                     String                   @default("ACTIVE")
  organization               String?
  investorVerified           Boolean                  @default(false)
  investorVerificationStatus String                   @default("NONE")
  investorNetWorth           String?
  investorThesis             String?
  investorTicketSize         String?
  investorSectors            String?
  investorPastDeals          String?
  sebiRegNumber              String?
  investorReviewedBy         Int?
  investorReviewedAt         DateTime?
  investorReviewNotes        String?
  mentorExpertise            String?
  mentorAvailability         String?
  mentorBio                  String?
  mentorIsActive             Boolean                  @default(false)
  termsAcceptedAt            DateTime?
  emailVerified              Boolean                  @default(false)
  emailVerifyToken           String?                  @unique
  emailVerifyExpires         DateTime?
  resetToken                 String?                  @unique
  resetTokenExpires          DateTime?
  failedLoginAttempts        Int                      @default(0)
  lockedUntil                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  adminAssignments           AdminRoleAssignment[]
  cofounderListing           CofounderListing?
  collaborationRequests      CollaborationRequest[]
  eventRSVPs                 EventRSVP[]
  agentProfile               FieldAgent?
  investmentInterests        InvestmentInterest[]
  jobApplications            JobApplication[]
  notifications              Notification[]
  checkIns                   OfficeCheckIn[]
  memberships                OrganizationMembership[]
  pressRequests              PressRequest[]
  reportsFiled               Report[]
  savedOrganizations         SavedOrganization[]
  sessions                   Session[]
  startups                   Startup[]
  reviewsGiven               StartupReview[]
}

model Startup {
  id                     Int                    @id @default(autoincrement())
  name                   String
  domain                 String?
  description            String?
  founderId              Int
  organizationId         Int?
  originType             String                 @default("INDEPENDENT")
  institutionName        String?
  institutionPartnerId   Int?
  registrationId         String?
  registrationIdType     String?
  registeredAddress      String?
  operationalAddress     String?
  foundedDate            String?
  stage                  String                 @default("IDEA")
  employeeCount          Int                    @default(1)
  teamPhotoUrl           String?
  badgeTier              String                 @default("NONE")
  documentsVerified      Boolean                @default(false)
  inspectionScore        Float?
  lastInspectedAt        DateTime?
  websiteUrl             String?
  productPhotoUrl        String?
  monthlyUsers           Int?
  monthlyRevenue         Float?
  totalFundingRaised     Float?
  pitchDeckUrl           String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  receivedCollabRequests CollaborationRequest[] @relation("StartupToStartupCollab")
  collaborationRequests  CollaborationRequest[]
  events                 Event[]
  inspections            InspectionReport[]
  investmentInterests    InvestmentInterest[]
  jobOpenings            JobOpening[]
  checkIns               OfficeCheckIn[]
  pressResponses         PressResponse[]
  institutionPartner     InstitutionPartner?    @relation(fields: [institutionPartnerId], references: [id])
  organization           Organization?          @relation(fields: [organizationId], references: [id])
  founder                User                   @relation(fields: [founderId], references: [id], onDelete: Cascade)
  documents              StartupDocument[]
  reviews                StartupReview[]
  teamMembers            TeamMember[]
  workLogs               WorkLog[]

  @@index([domain])
  @@index([stage])
  @@index([originType])
  @@index([badgeTier])
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  startupId Int
  name      String
  role      String?
  photoUrl  String?
  linkedin  String?
  isFounder Boolean  @default(false)
  createdAt DateTime @default(now())
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
}

model WorkLog {
  id         Int      @id @default(autoincrement())
  startupId  Int
  weekOf     String
  summary    String
  hoursSpent Int?
  milestone  Boolean  @default(false)
  createdAt  DateTime @default(now())
  startup    Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
}

model JobOpening {
  id              Int              @id @default(autoincrement())
  startupId       Int
  title           String
  description     String?
  skills          String?
  type            String?
  location        String?
  salaryMin       Int?
  salaryMax       Int?
  isOpen          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobApplications JobApplication[]
  startup         Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([startupId])
  @@index([isOpen])
}

model JobApplication {
  id        Int        @id @default(autoincrement())
  jobId     Int
  userId    Int
  status    String     @default("PENDING")
  coverNote String?
  resumeUrl String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
}

model CollaborationRequest {
  id            Int      @id @default(autoincrement())
  startupId     Int
  userId        Int?
  fromStartupId Int?
  message       String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  fromStartup   Startup? @relation("StartupToStartupCollab", fields: [fromStartupId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  startup       Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@index([fromStartupId])
}

model InvestmentInterest {
  id        Int      @id @default(autoincrement())
  startupId Int
  userId    Int
  amount    Float?
  message   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([startupId, userId])
}

model StartupReview {
  id                    Int      @id @default(autoincrement())
  startupId             Int
  userId                Int
  isAnonymous           Boolean  @default(false)
  cultureRating         Int
  transparencyRating    Int
  professionalismRating Int
  productRating         Int
  overallRating         Int
  reviewText            String
  visitType             String
  verifiedByCheckIn     Boolean  @default(false)
  startupResponse       String?
  isFlagged             Boolean  @default(false)
  flagReason            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startup               Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([startupId, userId])
  @@index([startupId])
}

model OfficeCheckIn {
  id          Int      @id @default(autoincrement())
  startupId   Int
  userId      Int
  purpose     String
  checkedInAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startup     Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId, userId])
}

model FieldAgent {
  id          Int                @id @default(autoincrement())
  userId      Int                @unique
  city        String
  state       String?
  isActive    Boolean            @default(true)
  totalVisits Int                @default(0)
  rating      Float?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspections InspectionReport[]

  @@index([city])
}

model InspectionReport {
  id               Int         @id @default(autoincrement())
  startupId        Int
  agentId          Int?
  tier             String      @default("BASIC")
  preferredDate    DateTime?
  requestNotes     String?
  status           String      @default("PENDING")
  legitimacyScore  Int?
  teamScore        Int?
  productScore     Int?
  workspaceScore   Int?
  momentumScore    Int?
  overallScore     Float?
  agentNotes       String?
  recommendedBadge String?
  exteriorPhotos   String?
  interiorPhotos   String?
  teamPhotos       String?
  productPhotos    String?
  visitedAt        DateTime?
  submittedAt      DateTime?
  approvedAt       DateTime?
  adminReviewNotes String?
  adminReviewedBy  Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  agent            FieldAgent? @relation(fields: [agentId], references: [id])
  startup          Startup     @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@index([status])
}

model CofounderListing {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  lookingFor    String
  skillsOffered String
  skillsWanted  String
  commitment    String
  domain        String?
  pitch         String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([domain])
}

model Event {
  id            Int         @id @default(autoincrement())
  title         String
  description   String?
  type          String
  startupId     Int?
  organizerName String
  eventDate     DateTime
  location      String?
  isVirtual     Boolean     @default(false)
  joinLink      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  startup       Startup?    @relation(fields: [startupId], references: [id])
  rsvps         EventRSVP[]

  @@index([eventDate])
  @@index([type])
}

model EventRSVP {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Grant {
  id          Int       @id @default(autoincrement())
  name        String
  provider    String
  description String
  eligibility String
  amountRange String?
  applyUrl    String?
  deadline    DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model PressRequest {
  id          Int             @id @default(autoincrement())
  userId      Int
  title       String
  description String
  domain      String?
  deadline    DateTime?
  status      String          @default("OPEN")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses   PressResponse[]

  @@index([status])
}

model PressResponse {
  id             Int          @id @default(autoincrement())
  pressRequestId Int
  startupId      Int
  message        String
  createdAt      DateTime     @default(now())
  startup        Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  pressRequest   PressRequest @relation(fields: [pressRequestId], references: [id], onDelete: Cascade)

  @@unique([pressRequestId, startupId])
}

model StartupDocument {
  id          Int      @id @default(autoincrement())
  startupId   Int
  docType     String
  fileUrl     String
  status      String   @default("PENDING")
  reviewNotes String?
  reviewedBy  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  startup     Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@index([status])
}

model Report {
  id          Int      @id @default(autoincrement())
  contentType String
  contentId   Int
  reportedBy  Int
  reason      String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  reporter    User     @relation(fields: [reportedBy], references: [id], onDelete: Cascade)

  @@index([contentType, contentId])
  @@index([status])
}

model InstitutionPartner {
  id           Int       @id @default(autoincrement())
  name         String
  contactName  String?
  contactEmail String?
  city         String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startups     Startup[]

  @@index([isActive])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AdminRoleAssignment {
  id          Int      @id @default(autoincrement())
  userId      Int
  role        String
  grantedById Int?
  approvalId  Int?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  category   String
  action     String
  severity   String   @default("INFO")
  outcome    String   @default("SUCCESS")
  actorId    Int?
  actorLabel String?
  targetType String?
  targetId   String?
  ip         String?
  metadata   String?

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([action])
  @@index([actorId])
}

model ApprovalRequest {
  id               Int       @id @default(autoincrement())
  type             String
  status           String    @default("PENDING")
  requestedById    Int
  reason           String
  payload          String
  decidedById      Int?
  decidedAt        DateTime?
  decisionNote     String?
  executedAt       DateTime?
  executionOutcome String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  @@index([status])
  @@index([requestedById])
}

model SecurityIncident {
  id             Int       @id @default(autoincrement())
  title          String
  description    String
  severity       String    @default("MEDIUM")
  status         String    @default("OPEN")
  createdById    Int
  resolutionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  resolvedAt     DateTime?

  @@index([status])
}

model SiteSetting {
  key         String    @id
  draft       String    @default("{}")
  published   String?
  version     Int       @default(0)
  updatedBy   Int?
  updatedAt   DateTime  @default(now()) @updatedAt
  publishedAt DateTime?
}

model SiteSettingHistory {
  id          Int      @id @default(autoincrement())
  key         String
  version     Int
  value       String
  publishedBy Int?
  createdAt   DateTime @default(now())

  @@unique([key, version])
}

model Session {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String
  deviceInfo String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

model VendorOffering {
  id             Int          @id @default(autoincrement())
  organizationId Int
  title          String
  description    String
  category       String
  capabilities   String?
  pricingModel   String?
  deployment     String?
  certifications String?
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([category])
}

model Rfq {
  id                  Int           @id @default(autoincrement())
  buyerOrganizationId Int
  title               String
  description         String
  category            String
  budgetRange         String?
  deadline            DateTime?
  status              String        @default("DRAFT")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  buyerOrganization   Organization  @relation("RfqBuyer", fields: [buyerOrganizationId], references: [id])
  responses           RfqResponse[]

  @@index([buyerOrganizationId])
  @@index([status])
  @@index([category])
}

model RfqResponse {
  id                   Int          @id @default(autoincrement())
  rfqId                Int
  vendorOrganizationId Int
  message              String
  priceQuote           String?
  attachments          String?
  status               String       @default("SUBMITTED")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  vendorOrganization   Organization @relation("RfqVendor", fields: [vendorOrganizationId], references: [id])
  rfq                  Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@unique([rfqId, vendorOrganizationId])
  @@index([rfqId])
  @@index([vendorOrganizationId])
}

model SavedOrganization {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation("SavedOrg", fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
}

model ProfileClaim {
  id             Int       @id @default(autoincrement())
  startupId      Int
  claimantUserId Int
  reason         String
  evidenceNote   String?
  status         String    @default("PENDING")
  reviewerId     Int?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([startupId])
  @@index([claimantUserId])
}

model ClaimEvidence {
  id         Int      @id @default(autoincrement())
  claimId    Int
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([claimId])
}
